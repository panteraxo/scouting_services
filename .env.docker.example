# ============================================================
# Scouting.pe - entorno de PRODUCCION para Docker / Aiven MySQL
# Copiar a .env.docker y completar. NUNCA commitear .env.docker.
# Para probar en local usa .env.docker.local.example.
# ============================================================

# ------------------------------------------------------------
# Aiven MySQL
# ------------------------------------------------------------
# En Aiven: servicio MySQL > Overview > Connection information.
# Crea primero la base de datos `scouting` (ver docs/despliegue/docker-aiven.md).
# Si tu contrasena contiene `$`, escribela como `$$` para que Docker Compose
# no la interprete como variable.
DB_URL=jdbc:mysql://HOST_AIVEN:PORT_AIVEN/scouting?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# Primera ejecucion: update (crea/actualiza tablas).
# Despues de verificar el esquema, cambiar a validate.
JPA_DDL_AUTO=update

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=9193
APP_CORS_ALLOWED_ORIGINS=https://app.scouting.net.pe
SESSION_COOKIE_SECURE=true
# Usa None solo si frontend y API estan en sitios distintos. Los navegadores
# pueden bloquear cookies de terceros; preferir app/api bajo el mismo dominio.
SESSION_COOKIE_SAME_SITE=Lax

# Bootstrap del primer ADMIN.
# Dejar enabled=false despues de crear el administrador.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DOCUMENT_TYPE=DNI
BOOTSTRAP_ADMIN_DOCUMENT_NUMBER=
BOOTSTRAP_ADMIN_PHONE=

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# Se incrusta en el build de Next.js. Cambiarlo exige reconstruir la imagen.
NEXT_PUBLIC_API_BASE_URL=https://api.scouting.net.pe/api/v1
