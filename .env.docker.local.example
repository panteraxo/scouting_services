# ============================================================
# Scouting.pe - entorno LOCAL para Docker / Aiven MySQL
# Copiar a .env.docker y completar. NUNCA commitear .env.docker.
# ============================================================

# ------------------------------------------------------------
# Aiven MySQL
# ------------------------------------------------------------
# Host/puerto desde Aiven. Tambien puedes apuntar a MySQL local con
# host.docker.internal:3306 si usas Docker Desktop y tu MySQL local no usa TLS.
# Alternativa local sin TLS (descomentar y ajustar credenciales):
# DB_URL=jdbc:mysql://host.docker.internal:3306/scouting?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://HOST_AIVEN:PORT_AIVEN/scouting?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=avnadmin
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

JPA_DDL_AUTO=update

# ------------------------------------------------------------
# Backend local
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=9193
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DOCUMENT_TYPE=DNI
BOOTSTRAP_ADMIN_DOCUMENT_NUMBER=
BOOTSTRAP_ADMIN_PHONE=

# ------------------------------------------------------------
# Frontend local
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:9193/api/v1
